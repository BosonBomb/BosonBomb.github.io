---
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const settings = await getEntry('site', 'settings');
const siteName = settings?.data.name ?? 'Sambhram Shetty';
const github = settings?.data.github ?? 'https://github.com/BosonBomb';

const {
	title,
	description = `${siteName} — notes on research, books, and things I am building.`,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : siteName;
const path = Astro.url.pathname;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Writing' },
	{ href: '/reading', label: 'Reading' },
	{ href: '/now', label: 'Now' },
	{ href: '/about', label: 'About' },
];

const isCurrent = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap wrap-wide">
				<a class="brand" href="/">{siteName}</a>
				<nav class="nav">
					{
						nav.map((item) => (
							<a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>

		<main>
			<div class="wrap">
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="wrap wrap-wide">
				<span>© {new Date().getFullYear()} {siteName}</span>
				<span>
					<a href={github}>GitHub</a>
					&nbsp;·&nbsp;
					<a href="/rss.xml">RSS</a>
				</span>
			</div>
		</footer>
	</body>
</html>
