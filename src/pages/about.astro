---
import fs from 'node:fs';
import path from 'node:path';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const settings = await getEntry('site', 'settings');
const hasPortrait = fs.existsSync(path.join(process.cwd(), 'public', 'portrait.jpg'));

const github = settings?.data.github ?? 'https://github.com/BosonBomb';
const handle = github.replace(/\/+$/, '').split('/').pop();
---

<BaseLayout title="About" description={`About ${settings?.data.name}.`}>
	<section class="hero">
		<div>
			<h1>About</h1>
			<p class="lede">{settings?.data.about}</p>
		</div>
		{
			hasPortrait ? (
				<img class="portrait" src="/portrait.jpg" alt={settings?.data.name} />
			) : (
				<div class="portrait-placeholder" aria-hidden="true">
					{settings?.data.name?.[0]}
				</div>
			)
		}
	</section>

	<div class="prose">
		<p>
			Right now I'm drawn to making models handle invariants more gracefully, and to
			general-purpose reinforcement learning inspired by the way systems like AlphaGo
			learned to play.
		</p>
		<h2>Elsewhere</h2>
		<ul class="list">
			<li><a href={github}>GitHub — @{handle}</a></li>
			<li><a href={`mailto:${settings?.data.email}`}>{settings?.data.email}</a></li>
		</ul>
	</div>
</BaseLayout>
