---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = await getCollection('projects');
const byOrder = (a: CollectionEntry<'projects'>, b: CollectionEntry<'projects'>) =>
	a.data.order - b.data.order;

const groups = [
	{ status: 'active', title: 'Working on' },
	{ status: 'exploring', title: 'Exploring' },
	{ status: 'paused', title: 'On the back burner' },
	{ status: 'done', title: 'Shipped' },
] as const;
---

<BaseLayout title="Now" description="What Sambhram Shetty is working on right now.">
	<h1>Now</h1>
	<p class="lede">
		A living page of what has my attention — updated whenever it changes.
	</p>

	{
		groups.map((group) => {
			const projects = all.filter((p) => p.data.status === group.status).sort(byOrder);
			if (projects.length === 0) return null;
			return (
				<section>
					<h2>{group.title}</h2>
					<div class="grid">
						{projects.map((project) => (
							<ProjectCard project={project} />
						))}
					</div>
				</section>
			);
		})
	}
</BaseLayout>
