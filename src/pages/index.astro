---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import BookRow from '../components/BookRow.astro';
import ProjectCard from '../components/ProjectCard.astro';

const hasPortrait = fs.existsSync(path.join(process.cwd(), 'public', 'portrait.jpg'));

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const reading = (await getCollection('books', ({ data }) => data.status === 'reading'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);

const projects = (await getCollection('projects', ({ data }) => data.status !== 'done'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 3);
---

<BaseLayout>
	<section class="hero">
		<div>
			<h1>Hi, I'm Sambhram.</h1>
			<p class="lede">
				I write about research, the books I'm moving through, and the things I'm building.
				This is a quiet corner of the internet I keep for myself — and for anyone who finds it.
			</p>
		</div>
		{
			hasPortrait ? (
				<img class="portrait" src="/portrait.jpg" alt="Sambhram Shetty" />
			) : (
				<div class="portrait-placeholder" aria-hidden="true">S</div>
			)
		}
	</section>

	<div class="section-head">
		<h2>Recent writing</h2>
		<a href="/blog">All posts →</a>
	</div>
	{
		posts.length > 0 ? (
			<div class="grid">
				{posts.map((post) => (
					<PostCard post={post} />
				))}
			</div>
		) : (
			<p class="empty">No posts yet — the first one is coming soon.</p>
		)
	}

	<div class="section-head">
		<h2>On my desk</h2>
		<a href="/now">See all →</a>
	</div>
	{
		projects.length > 0 ? (
			<div class="grid">
				{projects.map((project) => (
					<ProjectCard project={project} />
				))}
			</div>
		) : (
			<p class="empty">Nothing in progress right now.</p>
		)
	}

	<div class="section-head">
		<h2>Currently reading</h2>
		<a href="/reading">Reading list →</a>
	</div>
	{
		reading.length > 0 ? (
			<ul class="list">
				{reading.map((book) => (
					<BookRow book={book} />
				))}
			</ul>
		) : (
			<p class="empty">Between books at the moment.</p>
		)
	}
</BaseLayout>
